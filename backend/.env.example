DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://employermanage:employermanage@localhost:5433/employermanage
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# ATTESTATION_SECRET_KEY : clé HMAC pour l'authenticité des attestations (voir conges/attestation.py).
# Défaut = DJANGO_SECRET_KEY si absent ; à définir séparément en production pour pouvoir tourner
# l'une sans invalider l'autre.
ATTESTATION_SECRET_KEY=change-me-aussi

# Anti-bruteforce sur /api/auth/connexion/ (format DRF, ex. "5/min", "100/day").
# Valeur prudente recommandée en production ; le fichier .env de développement local peut monter
# ce chiffre pour ne pas gêner des tests manuels ou automatisés répétés.
THROTTLE_CONNEXION=10/min
